# PLANCK companion — Apache configuration for Hostinger.
# Deploy: rename to ".htaccess" in the /planck/ web root.
#
# Three jobs: (1) hide server-side files, (2) gzip + cache static assets so the
# already-small site transfers even smaller, (3) the optional access-code gate.

Options -Indexes
AddDefaultCharset utf-8

# --- 1. never serve source / secrets over the web --------------------------
<FilesMatch "(^config\.php$|\.(sql|py|md|sample)$|^\.)">
  Require all denied
</FilesMatch>

# --- 2. compression + caching (transfer-size wins) -------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png        "access plus 30 days"
  ExpiresByType image/gif        "access plus 30 days"
  ExpiresByType image/jpeg       "access plus 30 days"
  ExpiresByType text/css         "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  # HTML stations stay short so edits show up promptly
  ExpiresByType text/html        "access plus 1 hours"
</IfModule>

# --- 3. access-code gate (optional) ----------------------------------------
# Active only once you have codes in the DB and enable_access_codes = true.
# Strength note: this checks the pass cookie is PRESENT and well-formed. The HMAC
# (set by gate.php) makes it impractical to forge, but for a low-stakes private
# companion this is "good-enough" privacy, not hard security. For hard guarantees
# put the site behind Cloudflare Access (see DATA-LAYER.md / DEPLOY.md §2) instead.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /planck/

  # let the gate page, the API, and non-secret static assets load freely
  RewriteCond %{REQUEST_URI} ^/planck/api/ [OR]
  RewriteCond %{REQUEST_URI} \.(css|js|png|gif|jpe?g|svg|webp|woff2?|ico|csv)$ [NC]
  RewriteRule ^ - [L]

  # readers carrying a well-formed pass cookie pass through
  RewriteCond %{HTTP_COOKIE} (^|;\s)pk_pass=PLK-[A-Z2-9]{4}-[A-Z2-9]{3}\. [NC]
  RewriteRule ^ - [L]

  # everyone else (site root or any .html station) -> the gate
  RewriteCond %{REQUEST_URI} (/|\.html)$ [NC]
  RewriteRule ^ /planck/api/gate.php?next=%{REQUEST_URI} [R=302,L]
</IfModule>
